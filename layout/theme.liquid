<!doctype html>
<html lang="{{ request.locale.iso_code }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title>{{ page_title }}{% unless page_title contains shop.name %} · {{ shop.name }}{% endunless %}</title>
  {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}
  <link rel="icon" type="image/png" href="{{ 'favicon-cajuju.png' | asset_url }}" sizes="192x192">
  <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">
  <link rel="canonical" href="{{ canonical_url }}">
  {%- liquid
    assign og_type = 'website'
    assign og_image = 'hero.jpg' | asset_url
    if request.page_type == 'product'
      assign og_type = 'product'
      if product.featured_image
        assign og_image = product.featured_image | image_url: width: 1200
      endif
    endif
  -%}
  <meta property="og:site_name" content="Cajuju">
  <meta property="og:type" content="{{ og_type }}">
  <meta property="og:title" content="{{ page_title | escape }}">
  <meta property="og:url" content="{{ canonical_url }}">
  {% if page_description %}<meta property="og:description" content="{{ page_description | escape }}">{% endif %}
  <meta property="og:image" content="https:{{ og_image | remove: 'https:' }}">
  <meta name="twitter:card" content="summary_large_image">
  {%- if request.page_type == 'product' -%}
  <meta property="product:price:amount" content="{{ product.price | money_without_currency | replace: ',', '.' }}">
  <meta property="product:price:currency" content="{{ cart.currency.iso_code }}">
  <script type="application/ld+json">{{ product | structured_data }}</script>
  {%- endif -%}
  {%- if request.page_type == 'index' -%}
  <script type="application/ld+json">{"@context":"https://schema.org","@type":"Organization","name":"Cajuju","url":{{ shop.url | json }},"logo":{{ 'logo-cajuju.png' | asset_url | prepend: 'https:' | json }}}</script>
  {%- endif -%}
  {%- if request.page_type == 'index' -%}<link rel="preload" as="image" href="{{ 'hero.jpg' | asset_url }}" fetchpriority="high">{%- endif -%}
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:wght@600;700;800&family=Nunito+Sans:wght@400;600;700&display=swap" rel="stylesheet">
  {{ 'base.css' | asset_url | stylesheet_tag }}
  {{ content_for_header }}
</head>
<body>
  <a class="skip" href="#main">Saltar para o conteúdo</a>
  {% sections 'header-group' %}
  <main id="main">{{ content_for_layout }}</main>
  {% sections 'footer-group' %}
  <script src="{{ 'theme.js' | asset_url }}" defer></script>
</body>
</html>
