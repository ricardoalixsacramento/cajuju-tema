<section class="narrow" style="padding:56px 32px 64px"><h1 style="font-size:36px">Encomenda {{ order.name }}</h1><p class="muted">{{ order.created_at | date: '%d/%m/%Y' }}</p>
{%- for item in order.line_items -%}<p>{{ item.title }} × {{ item.quantity }} — {{ item.final_line_price | money }}</p>{%- endfor -%}
<p><strong>Total: {{ order.total_price | money }}</strong></p><a href="{{ routes.account_url }}">← Voltar à conta</a></section>
