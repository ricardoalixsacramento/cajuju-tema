<section class="narrow" style="padding:56px 32px 64px"><h1 style="font-size:40px;margin-bottom:8px">A minha conta</h1><p><a href="{{ routes.account_logout_url }}">Sair</a> · <a href="{{ routes.account_addresses_url }}">Moradas ({{ customer.addresses_count }})</a></p>
<h2 style="font-size:24px;margin:24px 0 12px">Encomendas</h2>
{%- paginate customer.orders by 20 -%}{%- for order in customer.orders -%}<p><a href="{{ order.customer_url }}">{{ order.name }}</a> · {{ order.created_at | date: '%d/%m/%Y' }} · {{ order.total_price | money }} · {{ order.fulfillment_status_label }}</p>{%- else -%}<p class="muted">Ainda não fez encomendas.</p>{%- endfor -%}{%- endpaginate -%}</section>
