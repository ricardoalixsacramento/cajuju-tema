<section class="narrow" style="padding:56px 32px 64px"><h1 style="font-size:36px;text-align:center;margin-bottom:24px">Nova palavra-passe</h1>
{%- form 'reset_customer_password', class: 'form-stack' -%}<div class="errors">{{ form.errors | default_errors }}</div><label for="p1">Palavra-passe</label><input class="field" id="p1" type="password" name="customer[password]"><label for="p2">Confirmar</label><input class="field" id="p2" type="password" name="customer[password_confirmation]"><button class="btn btn--dark" type="submit">Guardar</button>{%- endform -%}</section>
