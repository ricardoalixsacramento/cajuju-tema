{%- assign current = product.selected_or_first_available_variant -%}
<section class="page-width product">
  <div class="page-width-bleed">
    <div class="gallery" data-gallery>
      {%- for media in product.media limit: 10 -%}
        {%- if forloop.first -%}{%- assign ld = 'eager' -%}{%- else -%}{%- assign ld = 'lazy' -%}{%- endif -%}
        <div class="gallery__item">{{ media | image_url: width: 1600 | image_tag: loading: ld, widths: '400,600,800,1000,1300,1600', sizes: '(min-width: 900px) 55vw, 100vw', alt: media.alt | default: product.title }}</div>
      {%- else -%}
        <div class="gallery__item">{%- render 'pattern-fallback', product: product -%}</div>
      {%- endfor -%}
    </div>
    {%- if product.media.size > 1 -%}<div class="gallery__dots" data-dots aria-hidden="true">{%- for media in product.media limit: 10 -%}<span{% if forloop.first %} class="is-active"{% endif %}></span>{%- endfor -%}</div>{%- endif -%}
  </div>
  <div class="product__info">
    <nav class="crumbs" aria-label="Caminho"><a href="{{ routes.root_url }}">Início</a>{% if collection %} / <a href="{{ collection.url }}">{{ collection.title }}</a>{% endif %}</nav>
    <h1>{{ product.title }}</h1>
    <p class="product__price" data-price>{{ current.price | money }}</p>
    {%- form 'product', product, id: 'product-form' -%}
      {%- if product.has_only_default_variant -%}
        <input type="hidden" name="id" value="{{ current.id }}">
      {%- elsif product.options.size > 1 -%}
      <input type="hidden" name="id" value="{{ current.id }}" data-variant-id>
      <script type="application/json" data-variants>{{ product.variants | json }}</script>
      {%- for option in product.options_with_values -%}
        {%- assign oi = forloop.index0 -%}
        {%- assign is_pat = false -%}{%- if option.name contains 'Padr' -%}{%- assign is_pat = true -%}{%- endif -%}
        <fieldset class="sizes opt" data-opt-index="{{ oi }}">
          <legend><span><span class="opt__step">{{ forloop.index }}</span> {% if is_pat %}Escolhe o padrão{% else %}Escolhe o tamanho{% endif %}: <strong data-opt-label="{{ oi }}">{{ option.selected_value }}</strong></span>{% if is_pat == false and section.settings.size_link != blank %}<a class="link" style="font-weight:600;font-size:.9rem" href="{{ section.settings.size_link }}">Guia de tamanhos</a>{% endif %}</legend>
          <div class="sizes__list{% if is_pat %} swatches{% endif %}">
          {%- for value in option.values -%}
            <label class="{% if is_pat %}swatch{% else %}size{% endif %}"><input type="radio" name="opt-{{ oi }}" value="{{ value | escape }}" data-opt="{{ oi }}"{% if value == option.selected_value %} checked{% endif %}>
              {%- if is_pat -%}<span class="swatch__dot" style="background-image:url('{{ 'padrao-' | append: value | handleize | append: '.jpg' | asset_url }}')"></span><span class="swatch__name">{{ value }}</span>{%- else -%}<span>{{ value }}</span>{%- endif -%}
            </label>
          {%- endfor -%}
          </div>
          {%- unless is_pat -%}<p class="hint">A oferecer? Se o bebé ainda não nasceu, escolhe 1–3M; se já nasceu, um tamanho acima da idade. As trocas de tamanho são grátis durante 30 dias.</p>{%- endunless -%}
        </fieldset>
      {%- endfor -%}
      {%- else -%}
      <fieldset class="sizes">
        <legend><span>{{ product.options.first }}: <span data-size-label>{{ current.title }}</span></span>{% if section.settings.size_link != blank %}<a class="link" style="font-weight:600;font-size:.9rem" href="{{ section.settings.size_link }}">Guia de tamanhos</a>{% endif %}</legend>
        <div class="sizes__list">
        {%- for variant in product.variants -%}
          <label class="size"><input type="radio" name="id" value="{{ variant.id }}" data-variant data-title="{{ variant.title | escape }}" data-price="{{ variant.price | money | escape }}"{% if variant.id == current.id %} checked{% endif %}{% unless variant.available %} disabled{% endunless %}><span>{{ variant.title }}</span></label>
        {%- endfor -%}
        </div>
        <p class="hint">A oferecer? Se o bebé ainda não nasceu, escolhe 1–3M; se já nasceu, um tamanho acima da idade. As trocas de tamanho são grátis durante 30 dias.</p>
      </fieldset>
      {%- endif -%}
      {%- if product.tags contains 'presentes' -%}{%- render 'box-contents', product: product, current: current -%}{%- endif -%}
      {%- if product.tags contains 'presentes' -%}
      <div class="gift-note">
        <label for="gift-msg"><strong>Mensagem para o postal</strong> <span class="muted">(opcional, escrita à mão por nós)</span></label>
        <textarea id="gift-msg" class="field field--box" name="properties[Mensagem do postal]" maxlength="220" rows="3" placeholder="Ex.: Bem-vindo ao mundo, Tomás! Com amor, avó Rosa" data-count></textarea>
        <p class="muted hint" data-count-out>0/220</p>
      </div>
      {%- endif -%}
      <div class="buy" style="margin-top:20px">
        <div class="qty"><button type="button" data-qty="-1" aria-label="Menos">−</button><label class="vh" for="qty">Quantidade</label><input id="qty" type="number" name="quantity" value="1" min="1" inputmode="numeric"><button type="button" data-qty="1" aria-label="Mais">+</button></div>
        <button class="btn btn--primary" type="submit" data-buy{% unless product.available %} disabled{% endunless %}>{% if product.available %}Adicionar ao carrinho{% else %}Esgotado{% endif %}</button>
      </div>
    {%- endform -%}
    {%- if product.tags contains 'presentes' -%}
    <ul class="includes">
      <li>{% render 'icon', name: 'gift', size: 20, color: '#8A5A3C' %}Caixa com papel de seda e postal escrito à mão</li>
      <li>{% render 'icon', name: 'heart', size: 20, color: '#8A5A3C' %}Talão de oferta sem preço — podes enviar diretamente para quem recebe</li>
      <li>{% render 'icon', name: 'truck', size: 20, color: '#8A5A3C' %}Portes grátis em Portugal continental</li>
      <li>{% render 'icon', name: 'return', size: 20, color: '#8A5A3C' %}Trocas de tamanho grátis durante 30 dias</li>
    </ul>
    {%- endif -%}
    <div class="product__desc rte">{{ product.description }}</div>
    {%- unless product.tags contains 'presentes' -%}
    <a class="gift-cta" href="/collections/all/presentes">{% render 'icon', name: 'gift', size: 26, color: '#8A5A3C' %}<span><strong>É para oferecer?</strong><br>Vê as caixas de presente com peças do mesmo padrão. Chegam embrulhadas, com postal e portes grátis.</span>{% render 'icon', name: 'arrow', size: 18 %}</a>
    {%- endunless -%}
    <div class="badges">
      <div>{% render 'icon', name: 'home', color: '#8A5A3C' %}{{ section.settings.badge1 }}</div>
      <div>{% render 'icon', name: 'gift', color: '#8A5A3C' %}{{ section.settings.badge2 }}</div>
      <div>{% render 'icon', name: 'return', color: '#8A5A3C' %}{{ section.settings.badge3 }}</div>
    </div>
    <div class="acc">
      {%- for block in section.blocks -%}
      <details {{ block.shopify_attributes }}><summary>{{ block.settings.heading }}</summary><div class="rte">{{ block.settings.content }}</div></details>
      {%- endfor -%}
    </div>
  </div>
</section>
<div class="sticky-buy" data-sticky-buy aria-hidden="true">
  <div style="display:flex;flex-direction:column;line-height:1.2;min-width:0"><span style="font-size:.85rem;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">{{ product.title }}</span><strong data-price>{{ current.price | money }}</strong></div>
  <button class="btn btn--primary" type="submit" form="product-form" tabindex="-1"{% unless product.available %} disabled{% endunless %}>Adicionar</button>
</div>
{% schema %}
{"name":"Produto","settings":[
{"type":"text","id":"size_link","label":"Link do guia de tamanhos","default":"#guia"},
{"type":"text","id":"badge1","label":"Selo 1","default":"Feito em Portugal"},
{"type":"text","id":"badge2","label":"Selo 2","default":"Embrulho de oferta grátis"},
{"type":"text","id":"badge3","label":"Selo 3","default":"Trocas grátis 30 dias"}],
"blocks":[{"type":"collapsible","name":"Separador","settings":[{"type":"text","id":"heading","label":"Título"},{"type":"richtext","id":"content","label":"Conteúdo"}]}]}
{% endschema %}
