<section class="page-width section">
  <div class="story">
    <div class="story__media">{%- if section.settings.image -%}{{ section.settings.image | image_url: width: 1400 | image_tag: loading: 'lazy', widths: '600,900,1200,1400', sizes: '(min-width: 800px) 55vw, 100vw' }}{%- else -%}<img src="{{ 'p-hug-me-passaros-6.jpg' | asset_url }}" alt="Body Hug Me Pássaros num cesto de palha" loading="lazy" width="1122" height="1402">{%- endif -%}</div>
    <div class="story__text">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h2>{{ section.settings.title }}</h2>
      <p>{{ section.settings.text }}</p>
      {%- if section.settings.btn != blank -%}<div><a class="btn btn--dark" href="{{ section.settings.btn_link | default: '/pages/a-cajuju' }}">{{ section.settings.btn }}</a></div>{%- endif -%}
    </div>
  </div>
</section>
{% schema %}
{"name":"História da marca","settings":[
{"type":"image_picker","id":"image","label":"Imagem"},
{"type":"text","id":"eyebrow","label":"Etiqueta","default":"A nossa história"},
{"type":"text","id":"title","label":"Título","default":"Cada padrão começa num desenho"},
{"type":"textarea","id":"text","label":"Texto","default":"Cada padrão começa num desenho original. Depois escolhemos o tecido, estampamos, cortamos e cosemos em Portugal, em séries de poucas dezenas de peças. Quando um padrão acaba, pode não voltar."},
{"type":"text","id":"btn","label":"Botão","default":"Conhecer a Cajuju"},{"type":"url","id":"btn_link","label":"Link"}],
"presets":[{"name":"História da marca"}]}
{% endschema %}
