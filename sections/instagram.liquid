<section class="wrap section">
  <div style="text-align:center;margin-bottom:24px"><h2 style="font-size:32px"><a href="{{ section.settings.link | default: 'https://instagram.com/cajujubaby' }}">{{ section.settings.title }}</a></h2><p class="muted" style="margin:8px 0 0">{{ section.settings.text }}</p></div>
  <div class="insta">
    {%- for block in section.blocks -%}
      {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy' }}{%- else -%}<img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="800" height="1000">{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Instagram","settings":[
{"type":"text","id":"title","label":"Título","default":"@cajujubaby"},
{"type":"text","id":"text","label":"Texto","default":"Novidades em primeira mão e pequenos momentos das famílias Cajuju."},
{"type":"url","id":"link","label":"Link"}],
"blocks":[{"type":"photo","name":"Foto","settings":[{"type":"image_picker","id":"image","label":"Imagem"},{"type":"text","id":"fallback","label":"Imagem do tema (se vazio)","default":"romper-detalhe.jpg"}]}],
"max_blocks":6,"presets":[{"name":"Instagram"}]}
{% endschema %}
