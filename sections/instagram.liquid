<section class="page-width section">
  <div class="section-head"><div><h2>{{ section.settings.title }}</h2><p>{{ section.settings.text }}</p></div><a class="link" href="{{ section.settings.link | default: 'https://instagram.com/cajujubaby' }}">Seguir no Instagram</a></div>
  <div class="insta">
    {%- for block in section.blocks -%}
      <a href="{{ section.settings.link | default: 'https://instagram.com/cajujubaby' }}" aria-label="Instagram Cajuju">
      {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 500 | image_tag: loading: 'lazy', widths: '250,500', sizes: '(min-width: 700px) 20vw, 33vw', alt: '' }}{%- else -%}<img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="500" height="500">{%- endif -%}
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Instagram","settings":[
{"type":"text","id":"title","label":"Título","default":"@cajujubaby"},
{"type":"text","id":"text","label":"Texto","default":"Novidades em primeira mão e pequenos momentos das famílias Cajuju."},
{"type":"url","id":"link","label":"Link"}],
"blocks":[{"type":"photo","name":"Foto","settings":[{"type":"image_picker","id":"image","label":"Imagem"},{"type":"text","id":"fallback","label":"Imagem do tema (se vazio)","default":"romper-detalhe.jpg"}]}],
"max_blocks":5,"presets":[{"name":"Instagram"}]}
{% endschema %}
