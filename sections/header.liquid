{%- if section.settings.store_menu -%}{%- assign use_plan = false -%}{%- else -%}{%- assign use_plan = true -%}{%- endif -%}
{%- assign menu = linklists[section.settings.menu] -%}
<div class="site-header" data-header>
  <header class="page-width header">
    <div style="display:flex;align-items:center;gap:4px">
      <button type="button" class="icon-btn menu-toggle" data-drawer-open aria-controls="menu-drawer" aria-expanded="false" aria-label="Abrir menu">{% render 'icon', name: 'menu' %}</button>
      <nav class="header__nav" aria-label="Principal" data-v="142">
        {%- render 'nav-links', menu: menu, use_plan: use_plan -%}
      </nav>
    </div>
    <a class="header__logo" href="{{ routes.root_url }}" aria-label="Cajuju — início">
      {%- if section.settings.logo -%}{{ section.settings.logo | image_url: width: 400 | image_tag: alt: shop.name, widths: '200,400' }}{%- else -%}<img src="{{ 'logo-cajuju.png' | asset_url }}" alt="Cajuju" width="1200" height="423" class="logo-img">{%- endif -%}
    </a>
    <div class="header__tools">
      <a class="icon-btn" href="{{ routes.search_url }}" aria-label="Procurar">{% render 'icon', name: 'search' %}</a>
      {%- if shop.customer_accounts_enabled -%}<a class="icon-btn hide-mobile" href="{{ routes.account_url }}" aria-label="Conta">{% render 'icon', name: 'account' %}</a>{%- endif -%}
      <a class="icon-btn" data-cart-link href="{{ routes.cart_url }}" aria-label="Carrinho, {{ cart.item_count }} artigos">{% render 'icon', name: 'bag' %}{% if cart.item_count > 0 %}<span class="cart-count">{{ cart.item_count }}</span>{% endif %}</a>
    </div>
  </header>
</div>
<div class="drawer" id="menu-drawer" data-drawer aria-hidden="true">
  <div class="drawer__overlay" data-drawer-close></div>
  <div class="drawer__panel" role="dialog" aria-modal="true" aria-label="Menu">
    <div class="drawer__head"><span class="header__logo header__logo--drawer"><img src="{{ 'logo-cajuju.png' | asset_url }}" alt="Cajuju" width="1200" height="423" class="logo-img"></span><button type="button" class="icon-btn" data-drawer-close aria-label="Fechar menu">{% render 'icon', name: 'close' %}</button></div>
    <nav aria-label="Menu móvel">
      {%- render 'nav-links', menu: menu, use_plan: use_plan -%}
      {%- if shop.customer_accounts_enabled -%}<a href="{{ routes.account_url }}">A minha conta</a>{%- endif -%}
    </nav>
  </div>
</div>
{% schema %}
{"name":"Cabeçalho","settings":[
{"type":"checkbox","id":"store_menu","label":"Usar o menu da Shopify","info":"Desligado: menu Cajuju com Presentes, Padrões, Peças, Guia e Sobre nós.","default":false},
{"type":"link_list","id":"menu","label":"Menu da Shopify","default":"main-menu"},
{"type":"image_picker","id":"logo","label":"Logótipo (opcional)"},
{"type":"text","id":"logo_text","label":"Logótipo em texto","default":"cajuju"}]}
{% endschema %}
