<section class="page-width section">
  <div class="section-head"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div></div>
  <div class="categories">
    {%- for block in section.blocks -%}
      {%- assign c = collections[block.settings.collection] -%}
      {%- assign url = c.url | default: routes.all_products_collection_url -%}
      <a class="category" href="{{ url }}" {{ block.shopify_attributes }}>
        {%- if block.settings.image -%}{{ block.settings.image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 900px) 25vw, 50vw', alt: '' }}
        {%- elsif c.featured_image -%}{{ c.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400,600,800', sizes: '(min-width: 900px) 25vw, 50vw', alt: '' }}
        {%- else -%}<img src="{{ block.settings.fallback | asset_url }}" alt="" loading="lazy" width="800" height="1000">{%- endif -%}
        <span class="category__label">{{ block.settings.label | default: c.title }}{% render 'icon', name: 'arrow', size: 18 %}</span>
      </a>
    {%- endfor -%}
  </div>
</section>
{% schema %}
{"name":"Categorias","settings":[{"type":"text","id":"title","label":"Título","default":"Comprar por categoria"},{"type":"text","id":"text","label":"Texto"}],
"blocks":[{"type":"category","name":"Categoria","settings":[{"type":"text","id":"collection","label":"Identificador da coleção (handle)"},{"type":"text","id":"label","label":"Nome"},{"type":"image_picker","id":"image","label":"Imagem"},{"type":"text","id":"fallback","label":"Imagem do tema (se vazio)","default":"cenouras.jpg"}]}],
"max_blocks":4,"presets":[{"name":"Categorias"}]}
{% endschema %}
