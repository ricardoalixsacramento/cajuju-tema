{%- if request.page_type != 'page' or page.handle == 'a-cajuju' or page.template_suffix == 'sobre' -%}
<section class="narrow about-intro">
  <p class="eyebrow">{{ section.settings.eyebrow }}</p>
  <h1>{{ section.settings.title }}</h1>
  <p class="lead">{{ section.settings.text }}</p>
</section>
<section class="page-width"><div class="three">
  {%- for i in (1..3) -%}
    {%- assign key = 'image_' | append: i -%}{%- assign img = section.settings[key] -%}
    {%- if img -%}{{ img | image_url: width: 900 | image_tag: loading: 'lazy' }}{%- else -%}
      {%- case i -%}{%- when 1 -%}<img src="{{ 'cenouras.jpg' | asset_url }}" alt="Bebé a sorrir com body de cenouras" loading="lazy" width="800" height="1000">{%- when 2 -%}<img src="{{ 'romper-detalhe.jpg' | asset_url }}" alt="Detalhe da gola de folhos" loading="lazy" width="800" height="1000">{%- else -%}<img src="{{ 'cat-babygrows.jpg' | asset_url }}" alt="Bebé com babygrow branco" loading="lazy" width="800" height="1000">{%- endcase -%}
    {%- endif -%}
  {%- endfor -%}
</div></section>
<section class="page-width section"><div class="cards3">
  {%- for block in section.blocks -%}<div class="info-card{% if forloop.last %} info-card--blue{% endif %}" {{ block.shopify_attributes }}><h2>{{ block.settings.title }}</h2><p>{{ block.settings.text }}</p></div>{%- endfor -%}
</div></section>
{%- endif -%}
{% schema %}
{"name":"Sobre nós","settings":[
{"type":"text","id":"eyebrow","label":"Etiqueta","default":"Sobre nós"},
{"type":"text","id":"title","label":"Título","default":"Vestir com calma o que é pequeno"},
{"type":"textarea","id":"text","label":"Introdução","default":"Somos uma marca portuguesa de roupa de bebé. Acreditamos que os primeiros meses pedem peças simples, macias e bonitas, por isso escolhemos tecidos de algodão, cores suaves e uma produção feita em Portugal."},
{"type":"image_picker","id":"image_1","label":"Imagem 1"},{"type":"image_picker","id":"image_2","label":"Imagem 2"},{"type":"image_picker","id":"image_3","label":"Imagem 3"}],
"blocks":[{"type":"card","name":"Cartão","settings":[{"type":"text","id":"title","label":"Título"},{"type":"textarea","id":"text","label":"Texto"}]}],
"max_blocks":3,"presets":[{"name":"Sobre nós"}]}
{% endschema %}
