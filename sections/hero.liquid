<section class="hero">
  <div class="hero__box">
    {%- if section.settings.image -%}
      {{ section.settings.image | image_url: width: 2000 | image_tag: class: 'hero__img', alt: section.settings.image.alt, loading: 'eager', widths: '750,1100,1500,2000' }}
    {%- else -%}
      <img class="hero__img" src="{{ 'hero.jpg' | asset_url }}" alt="Bebé com romper de gola de folhos sentada numa manta azul" width="1600" height="900">
    {%- endif -%}
    <div class="hero__text">
      <p class="eyebrow">{{ section.settings.eyebrow }}</p>
      <h1>{{ section.settings.title }}</h1>
      <p class="sub">{{ section.settings.text }}</p>
      <div class="row">
        <a class="btn btn--primary" href="{{ section.settings.btn1_link | default: routes.all_products_collection_url }}">{{ section.settings.btn1 }}</a>
        {%- if section.settings.btn2 != blank -%}<a class="btn btn--light" href="{{ section.settings.btn2_link | default: '/pages/a-cajuju' }}">{{ section.settings.btn2 }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>
{% schema %}
{"name":"Banner principal","settings":[
{"type":"image_picker","id":"image","label":"Imagem"},
{"type":"text","id":"eyebrow","label":"Etiqueta","default":"Feito em Portugal · Pensado para o bebé"},
{"type":"text","id":"title","label":"Título","default":"Roupa macia para os primeiros abraços"},
{"type":"textarea","id":"text","label":"Subtítulo","default":"Peças em algodão, feitas em Portugal, pensadas para a pele delicada do bebé e para o dia a dia dos pais."},
{"type":"text","id":"btn1","label":"Botão 1","default":"Ver coleção"},{"type":"url","id":"btn1_link","label":"Link botão 1"},
{"type":"text","id":"btn2","label":"Botão 2","default":"A nossa história"},{"type":"url","id":"btn2_link","label":"Link botão 2"}],
"presets":[{"name":"Banner principal"}]}
{% endschema %}
