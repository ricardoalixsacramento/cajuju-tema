<section class="page-width page-head">
  {%- assign tagtitle = current_tags.first -%}
  {%- if tagtitle == 'presentes' -%}{%- assign heading = 'Caixas de presente' -%}{%- elsif tagtitle -%}{%- assign heading = 'Padrão ' | append: tagtitle -%}{%- elsif collection.handle == 'all' -%}{%- assign heading = 'Todas as peças' -%}{%- else -%}{%- assign heading = collection.title -%}{%- endif -%}
  <nav class="crumbs" aria-label="Caminho"><a href="{{ routes.root_url }}">Início</a> / {{ heading }}</nav>
  <h1>{{ heading }}</h1>
  {%- if tagtitle == 'presentes' -%}<p class="desc">Peças do mesmo padrão, escolhidas para combinar. Chegam embrulhadas, com papel de seda, um postal escrito à mão com a tua mensagem e talão de oferta sem preço. Portes grátis.</p>
  {%- elsif tagtitle -%}{%- render 'pattern-line', tag: tagtitle -%}
  {%- elsif collection.description != blank -%}<div class="desc rte">{{ collection.description }}</div>{%- elsif section.settings.fallback != blank -%}<p class="desc">{{ section.settings.fallback }}</p>{%- endif -%}
</section>
<div class="page-width toolbar">
  <div class="chips">
    <a class="chip{% if collection.handle == 'all' and current_tags == empty %} is-active{% endif %}" href="{{ routes.all_products_collection_url }}">Tudo</a>
    <a class="chip{% if current_tags contains 'presentes' %} is-active{% endif %}" href="/collections/all/presentes">Presentes</a>
    {%- assign pats = 'Pássaros,Dente-de-leão,Mirtilos,Cenouras,Limões,Cogumelos' | split: ',' -%}
    {%- for p in pats -%}<a class="chip{% if current_tags contains p %} is-active{% endif %}" href="/collections/all/{{ p | handleize }}">{{ p }}</a>{%- endfor -%}
    {%- assign menu = linklists[section.settings.menu] -%}
    {%- for link in menu.links -%}<a class="chip{% if link.active %} is-active{% endif %}" href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
  </div>
  <div style="display:flex;align-items:center;gap:16px">
    <span class="count">{{ collection.products.size }} {% if collection.products.size == 1 %}artigo{% else %}artigos{% endif %}</span>
    <label class="sort"><span class="vh">Ordenar por</span>
      <select class="select" data-sort>
        {%- for opt in collection.sort_options -%}<option value="{{ opt.value }}"{% if opt.value == collection.sort_by %} selected{% endif %}>{{ opt.name }}</option>{%- endfor -%}
      </select>
    </label>
  </div>
</div>
{%- paginate collection.products by 24 -%}
<section class="page-width">
  <div class="grid-products">
    {%- for product in collection.products -%}{%- render 'product-card', product: product -%}{%- else -%}<p class="muted">Ainda não há peças nesta coleção.</p>{%- endfor -%}
  </div>
  {%- if paginate.pages > 1 -%}<nav class="pagination" aria-label="Páginas">{%- if paginate.previous -%}<a class="btn btn--light" href="{{ paginate.previous.url }}">Anterior</a>{%- endif -%}<span>{{ paginate.current_page }} / {{ paginate.pages }}</span>{%- if paginate.next -%}<a class="btn btn--light" href="{{ paginate.next.url }}">Seguinte</a>{%- endif -%}</nav>{%- endif -%}
</section>
{%- endpaginate -%}
{% schema %}
{"name":"Coleção","settings":[
{"type":"link_list","id":"menu","label":"Filtros rápidos (menu)"},
{"type":"textarea","id":"fallback","label":"Descrição se a coleção não tiver","default":"Babygrows, bodies, conjuntos e acessórios com padrões originais, feitos em Portugal. Escolhe por padrão para montar uma família de peças que combinam."}]}
{% endschema %}
