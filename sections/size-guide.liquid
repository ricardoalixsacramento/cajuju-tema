{%- unless product and product.has_only_default_variant -%}
<section class="page-width section" id="guia">
  <div class="box">
    <h2>{{ section.settings.title }}</h2>
    <div class="table-wrap"><table><thead><tr><th scope="col">Tamanho</th><th scope="col">Idade</th><th scope="col">Altura (cm)</th></tr></thead><tbody>
    {%- for block in section.blocks -%}<tr {{ block.shopify_attributes }}><td>{{ block.settings.size }}</td><td>{{ block.settings.age }}</td><td>{{ block.settings.height }}</td></tr>{%- endfor -%}
    </tbody></table></div>
    {%- if section.settings.note != blank -%}<p class="muted" style="margin-top:14px;font-size:.9rem">{{ section.settings.note }}</p>{%- endif -%}
  </div>
</section>
{%- endunless -%}
{% schema %}
{"name":"Guia de tamanhos","settings":[{"type":"text","id":"title","label":"Título","default":"Guia de tamanhos"},{"type":"text","id":"note","label":"Nota","default":"Use a altura do bebé como referência principal. Se estiver entre dois tamanhos, escolha o maior."}],
"blocks":[{"type":"row","name":"Tamanho","settings":[{"type":"text","id":"size","label":"Tamanho"},{"type":"text","id":"age","label":"Idade"},{"type":"text","id":"height","label":"Altura"},{"type":"text","id":"weight","label":"Peso"}]}],
"presets":[{"name":"Guia de tamanhos"}]}
{% endschema %}
