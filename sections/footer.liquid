<footer class="site-footer">
  <div class="page-width footer">
    <div class="footer__brand"><span class="header__logo" style="font-size:1.8rem">cajuju</span><p>{{ section.settings.tagline }}</p></div>
    {%- for block in section.blocks -%}
      {%- assign menu = linklists[block.settings.menu] -%}
      <div class="footer__col" {{ block.shopify_attributes }}><h3>{{ block.settings.title }}</h3>
        <ul>{%- for link in menu.links -%}<li><a href="{{ link.url }}">{{ link.title }}</a></li>{%- endfor -%}</ul>
      </div>
    {%- endfor -%}
    <div class="footer__col"><h3>Contactos</h3><ul>
      {%- if section.settings.email != blank -%}<li><a href="mailto:{{ section.settings.email }}">{{ section.settings.email }}</a></li>{%- endif -%}
      <li><a href="{{ section.settings.instagram | default: 'https://instagram.com/cajujubaby' }}">Instagram</a></li>
      <li><a href="https://www.livroreclamacoes.pt">Livro de Reclamações</a></li>
    </ul></div>
  </div>
  <div class="page-width footer__bottom"><span>© {{ 'now' | date: '%Y' }} {{ shop.name }}{% if section.settings.legal != blank %} · {{ section.settings.legal }}{% endif %}</span><span>Feito em Portugal</span></div>
</footer>
{% schema %}
{"name":"Rodapé","settings":[
{"type":"text","id":"tagline","label":"Frase","default":"Roupa de bebé feita em Portugal, com tecidos macios e detalhes que fazem sorrir."},
{"type":"text","id":"email","label":"Email"},
{"type":"url","id":"instagram","label":"Instagram"},
{"type":"text","id":"legal","label":"Empresa · NIF"}],
"blocks":[{"type":"menu","name":"Coluna de links","settings":[{"type":"text","id":"title","label":"Título","default":"Ajuda"},{"type":"link_list","id":"menu","label":"Menu","default":"footer"}]}],
"max_blocks":2}
{% endschema %}
