{%- if section.settings.text != blank -%}
{%- assign msgs = section.settings.text | split: ' · ' -%}
<div class="announcement" role="region" aria-label="Avisos">
  {%- if section.settings.link != blank -%}<a href="{{ section.settings.link }}">{%- endif -%}
  <span class="announcement__track" style="--n:{{ msgs.size }}">
    {%- for m in msgs -%}<span class="announcement__msg" style="--i:{{ forloop.index0 }}">{{ m }}</span>{%- unless forloop.last -%}<span class="announcement__sep" aria-hidden="true"> · </span>{%- endunless -%}{%- endfor -%}
  </span>
  {%- if section.settings.link != blank -%}</a>{%- endif -%}
</div>
{%- endif -%}
{% schema %}
{"name":"Barra de anúncio","settings":[
{"type":"text","id":"text","label":"Texto","info":"Separa as mensagens com ' · '. No telemóvel aparecem uma de cada vez.","default":"Portes grátis a partir de 50 € · Embrulho de oferta grátis · Trocas de tamanho em 30 dias"},
{"type":"url","id":"link","label":"Link"}]}
{% endschema %}
