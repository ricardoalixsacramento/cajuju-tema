{%- if section.settings.text != blank -%}
<div class="announcement">{% if section.settings.link != blank %}<a href="{{ section.settings.link }}">{{ section.settings.text }}</a>{% else %}{{ section.settings.text }}{% endif %}</div>
{%- endif -%}
{% schema %}
{"name":"Barra de anúncio","settings":[
{"type":"text","id":"text","label":"Texto","default":"Portes grátis a partir de 50 € · Embrulho de oferta grátis · Trocas de tamanho em 30 dias"},
{"type":"url","id":"link","label":"Link"}]}
{% endschema %}
