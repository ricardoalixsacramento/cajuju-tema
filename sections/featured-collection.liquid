{%- assign coll = section.settings.collection -%}
{%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}
<section class="page-width section">
  <div class="section-head"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div><a class="link" href="{{ coll.url | default: routes.all_products_collection_url }}">Ver tudo</a></div>
  <div class="grid-products">
    {%- if coll.products_count > 0 -%}
      {%- for product in coll.products limit: section.settings.limit -%}{%- render 'product-card', product: product -%}{%- endfor -%}
    {%- else -%}
      {%- assign demo = 'cat-bodies.jpg|cat-babygrows.jpg|cat-conjuntos.jpg|cat-acessorios.jpg' | split: '|' -%}
      {%- for img in demo -%}
      <a class="card" href="{{ routes.all_products_collection_url }}"><div class="card__media"><img src="{{ img | asset_url }}" alt="" loading="lazy" width="800" height="1000"></div><h3 class="card__title">Novidade Cajuju</h3><p class="card__price muted">Em breve</p></a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Produtos em destaque","settings":[
{"type":"text","id":"title","label":"Título","default":"Novidades"},
{"type":"text","id":"text","label":"Texto"},
{"type":"collection","id":"collection","label":"Coleção"},
{"type":"range","id":"limit","label":"Nº de produtos","min":4,"max":12,"step":4,"default":4}],
"presets":[{"name":"Produtos em destaque"}]}
{% endschema %}
