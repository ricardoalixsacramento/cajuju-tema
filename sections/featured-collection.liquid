{%- assign coll = section.settings.collection -%}
{%- if coll == blank -%}{%- assign coll = collections.all -%}{%- endif -%}
<section class="page-width section">
  <div class="section-head"><div><h2>{{ section.settings.title }}</h2>{% if section.settings.text != blank %}<p>{{ section.settings.text }}</p>{% endif %}</div><a class="link" href="{{ section.settings.link | default: coll.url | default: routes.all_products_collection_url }}">Ver tudo</a></div>
  <div class="grid-products grid-products--scroll">
    {%- if section.settings.product_type != blank -%}
      {%- assign shown = 0 -%}
      {%- for product in collections.all.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- if product.type == section.settings.product_type -%}{%- render 'product-card', product: product -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}
      {%- endfor -%}
    {%- elsif coll.products_count > 0 -%}
      {%- assign shown = 0 -%}{%- assign seen = '' -%}
      {%- for product in coll.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign model = product.title | split: ' ' | first -%}
        {%- assign key = '|' | append: model | append: '|' -%}
        {%- unless product.tags contains 'presentes' or seen contains key -%}{%- if product.featured_media -%}{%- render 'product-card', product: product -%}{%- assign seen = seen | append: key -%}{%- assign shown = shown | plus: 1 -%}{%- endif -%}{%- endunless -%}
      {%- endfor -%}
      {%- for product in coll.products -%}
        {%- if shown >= section.settings.limit -%}{%- break -%}{%- endif -%}
        {%- assign model = product.title | split: ' ' | first -%}{%- assign key = '|' | append: model | append: '|' -%}
        {%- unless seen contains key or product.tags contains 'presentes' -%}{%- render 'product-card', product: product -%}{%- assign seen = seen | append: key -%}{%- assign shown = shown | plus: 1 -%}{%- endunless -%}
      {%- endfor -%}
    {%- else -%}
      {%- assign demo = 'cat-bodies.jpg|cat-babygrows.jpg|cat-conjuntos.jpg|cat-acessorios.jpg' | split: '|' -%}
      {%- for img in demo -%}
      <a class="card" href="{{ routes.all_products_collection_url }}"><div class="card__media"><img src="{{ img | asset_url }}" alt="" loading="lazy" width="800" height="1000"></div><h3 class="card__title">Novidade Cajuju</h3><p class="card__price muted">Em breve</p></a>
      {%- endfor -%}
    {%- endif -%}
  </div>
</section>
{% schema %}
{"name":"Produtos em destaque","settings":[
{"type":"text","id":"title","label":"Título","default":"Novidades"},
{"type":"text","id":"text","label":"Texto"},
{"type":"collection","id":"collection","label":"Coleção"},
{"type":"text","id":"product_type","label":"Só produtos do tipo","info":"Ex.: Sapatinhos. Mostra todas as peças desse tipo."},
{"type":"url","id":"link","label":"Link de 'Ver tudo'"},
{"type":"range","id":"limit","label":"Nº de produtos","min":4,"max":12,"step":4,"default":4}],
"presets":[{"name":"Produtos em destaque"}]}
{% endschema %}
