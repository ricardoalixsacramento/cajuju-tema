<section class="narrow" style="padding-top:56px;padding-bottom:64px"><h1 style="font-size:42px;margin-bottom:24px">{{ blog.title }}</h1>
{%- paginate blog.articles by 12 -%}{%- for article in blog.articles -%}<article style="padding:20px 0;border-bottom:1px solid var(--line)"><h2 style="font-size:24px"><a href="{{ article.url }}">{{ article.title }}</a></h2><p class="muted">{{ article.excerpt_or_content | strip_html | truncate: 180 }}</p></article>{%- endfor -%}{%- endpaginate -%}</section>
{% schema %}{"name":"Blog"}{% endschema %}
