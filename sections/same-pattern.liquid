{%- assign pats = 'Pássaros,Dente-de-leão,Mirtilos,Cenouras,Limões,Cogumelos' | split: ',' -%}
{%- assign mine = '' -%}
{%- for p in pats -%}{%- if product.tags contains p -%}{%- assign mine = p -%}{%- endif -%}{%- endfor -%}
{%- if mine != '' -%}
<section class="page-width section">
  <div class="section-head"><div><p class="eyebrow">Mesmo padrão</p><h2>A família {{ mine }}</h2><p>Peças que combinam com esta, para completar o conjunto ou montar um presente.</p></div><a class="link" href="/collections/all/{{ mine | handleize }}">Ver todas</a></div>
  <div class="grid-products grid-products--scroll">
    {%- assign shown = 0 -%}
    {%- for p in collections.all.products -%}
      {%- if p.tags contains mine and p.id != product.id and shown < 4 -%}{%- assign shown = shown | plus: 1 -%}{%- render 'product-card', product: p -%}{%- endif -%}
    {%- endfor -%}
  </div>
</section>
{%- endif -%}
{% schema %}{"name":"Mesmo padrão"}{% endschema %}
